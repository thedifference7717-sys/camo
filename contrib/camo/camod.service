[Unit]
Description=CAMO full node (seed)
After=network-online.target
Wants=network-online.target

[Service]
User=camo
Group=camo
Type=simple
ExecStart=/usr/local/bin/camod --non-interactive --data-dir /var/lib/camo \
  --p2p-bind-ip 0.0.0.0 --p2p-bind-port 19740 \
  --rpc-bind-ip 127.0.0.1 --rpc-bind-port 19741 \
  --out-peers 64 --in-peers 128 --log-level 0
Restart=always
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
